# Copy this file to ".env" in the same folder, then fill in.
# .env is gitignored -- keep it that way, these are credentials.

# --- Instagram (required to post) -------------------------------------------
# Both values come from Meta. Get them with:
#   python post_instagram.py --setup
# IG_USER_ID is the Instagram *Business* account id (~17 digits).
# IG_ACCESS_TOKEN is a long-lived token starting with "EAA...", expires ~60 days.
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Approval chat (optional) -----------------------------------------------
# Where the "approve this video" card gets posted. Leave blank to approve by
# opening the local URL the script prints.
#
# Google Chat  (needs Google WORKSPACE -- not available on @gmail.com accounts):
#   Space -> Apps & integrations -> Webhooks -> Add webhooks -> copy URL
# Discord (works on any free account):
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Slack:
#   api.slack.com/apps -> your app -> Incoming Webhooks -> Add to Workspace
CHAT_WEBHOOK=

# Port for the local approval page.
APPROVE_PORT=8770

# --- Discord bot (optional, for /post) --------------------------------------
# Lets you trigger runs and approve with buttons from Discord, replacing the
# webhook + tunnel flow entirely.
#
#   1. discord.com/developers/applications -> New Application
#   2. Bot -> Reset Token -> copy it here
#   3. Installation -> Guild Install, scopes: bot + applications.commands,
#      bot permissions: Send Messages, Attach Files, Use Slash Commands
#   4. open the generated install URL, add it to your server
#   5. python bot.py     (then type /post in Discord)
#
# No privileged intents needed -- leave all three toggles OFF in the portal.
DISCORD_BOT_TOKEN=

# Numeric channel id the scheduled run posts into (Server settings ->
# Channels -> right-click channel -> Copy Channel ID; Developer Mode on).
# Required by bot.py for .trigger / scheduled runs. Missing from the
# original Buzzit example -- do not omit it.
DISCORD_CHANNEL_ID=

# --- Makeo platform (later PRs; do not put tenant IG tokens here) -----------
# Comment-only until the worker/site exist. Uncomment on the host, never
# commit the filled values. Tenant Gemini/Flow/IG secrets belong in the
# database, not this file.
#
# MAKEO_MASTER_KEY=     # 32-byte Fernet key for token encryption
# MAKEO_WORKER_KEY=     # shared secret for loopback internal routes
# META_APP_ID=          # Meta app id for fb_exchange_token slide-refresh
# META_APP_SECRET=      # Meta app secret (platform-only)
